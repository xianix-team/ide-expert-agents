# AI Hub settings for the IDE Expert Agents MCP server.
# Copy to mcp-server/.env (gitignored) or point IDE_AGENTS_AI_HUB_ENV_FILE at your copy.
# Never commit the filled-in file: it holds your API key.

IDE_AGENTS_AI_HUB_BASE_URL=https://ai-hub-api.99x.io
IDE_AGENTS_AI_HUB_API_KEY=
IDE_AGENTS_AI_HUB_ACTOR=

# Optional: receives events from every agent not listed below.
IDE_AGENTS_AI_HUB_NODE_ID=

# Agent name (the `name` in its frontmatter) = AI Hub node id
# delivery-commitment-health-report=nd_...
# owasp-security-scanner=nd_...
